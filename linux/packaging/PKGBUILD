# Maintainer: KOLPSE <https://github.com/KOLPSE>
#
# Copia canonica del PKGBUILD que se publica en el AUR como `neofy-bin`. Vive
# aqui para que se actualice junto al codigo; el AUR es un repositorio git
# aparte al que se sube este mismo fichero mas su .SRCINFO.
#
# Es un paquete -bin porque compilar desde fuentes obligaria a cada usuario a
# bajarse Flutter entero y a compilar dos binarios de Rust cuyo target/ pasa de
# 3 GB. El tarball lo genera GitHub Actions sobre ubuntu-latest, cuya glibc es
# mas antigua que la de Arch: por eso el binario corre aqui.
#
# Para subir de version: cambiar pkgver, actualizar sha256sums (el propio
# workflow lo imprime al terminar) y regenerar .SRCINFO con
#   makepkg --printsrcinfo > .SRCINFO

pkgname=neofy-bin
_pkgname=neofy
pkgver=0.1.2
pkgrel=1
pkgdesc="Cliente de Spotify ligero y nativo (Flutter + librespot)"
arch=('x86_64')
url="https://github.com/KOLPSE/NeoFy"
license=('MIT')

depends=(
  'gtk3'
  # La bandeja. En GNOME hace falta ademas la extension de AppIndicator; sin
  # ella el icono no aparece, y por eso la app detecta que no hay bandeja y
  # deja que la X cierre de verdad en vez de esconderse sin retorno.
  'libayatana-appindicator'
  # El backend de audio de librespot. Lo aporta pipewire-pulse en cualquier
  # escritorio moderno.
  'libpulse'
  # Solo lo pide el sidecar de metadatos: librespot va con rustls, pero
  # librespot-core arrastra native-tls por sus features por defecto.
  'openssl'
)
optdepends=(
  'gnome-shell-extension-appindicator: icono de bandeja en GNOME'
)
provides=("$_pkgname")
conflicts=("$_pkgname")
options=('!strip')

_tarball="NeoFy-$pkgver-linux-x86_64"
source=("$_tarball.tar.gz::$url/releases/download/v$pkgver/$_tarball.tar.gz")
# ⚠️ SKIP es el valor de partida, no el bueno: hay que sustituirlo por el hash
# real ANTES de subir cada version al AUR. Con SKIP, makepkg se traga cualquier
# cosa que le sirva esa url. El workflow de Linux lo imprime al terminar, y
# tambien sale con: makepkg -g
sha256sums=('SKIP')

package() {
  cd "$srcdir/$_tarball"

  # El bundle va entero a /opt y no se reparte por /usr: el ejecutable de
  # Flutter busca data/ y lib/ a su lado, y separarlos lo rompe.
  install -dm755 "$pkgdir/opt/$_pkgname"
  cp -r data lib "$pkgdir/opt/$_pkgname/"
  install -Dm755 neofy "$pkgdir/opt/$_pkgname/neofy"
  install -Dm755 librespot "$pkgdir/opt/$_pkgname/librespot"
  install -Dm755 metadata-sidecar "$pkgdir/opt/$_pkgname/metadata-sidecar"

  # El enlace es seguro: Dart resuelve Platform.resolvedExecutable al destino
  # real, asi que findBinary() sigue encontrando los sidecars en /opt.
  install -dm755 "$pkgdir/usr/bin"
  ln -s "/opt/$_pkgname/neofy" "$pkgdir/usr/bin/$_pkgname"

  install -Dm644 xyz.neogex.neofy.desktop \
    "$pkgdir/usr/share/applications/xyz.neogex.neofy.desktop"

  for tamano in 16 24 32 48 64 128 256; do
    install -Dm644 "icons/${tamano}x${tamano}/neofy.png" \
      "$pkgdir/usr/share/icons/hicolor/${tamano}x${tamano}/apps/$_pkgname.png"
  done

  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
